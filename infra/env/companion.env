# Companion config (non-secret, committed). Read by config/env.py. `~` is expanded.
# Per-machine and personal values go in .env.local (gitignored), never here:
#   HOST_LAN_IP (else detected), ADDON_DOMAIN (else the stremio.rocks certificate),
#   TV_HOST + TV_OS (only for `mise run tv`), CLAUDE_CLI (if Claude Code lives elsewhere).
STREMIO_SERVER_URL=http://127.0.0.1:11470
COMPANION_HOST=0.0.0.0
COMPANION_PORT=11471
LOG_LEVEL=INFO
LOG_FORMAT=json
COMPANION_DATA_DIR=~/Library/Application Support/stremio-plus-plus/companion
# The user's settings (config.toml, secrets.toml): written with defaults on first start.
CONFIG_DIR=~/.config/stremio-plus-plus
# Built admin UI (`mise run ui:build`), relative to the repo (the companion runs from it).
UI_DIR=web/dist
STREMIO_SERVER_LOG=~/Library/Logs/stremio-plus-plus/server.log
STREMIO_SERVER_DATA_DIR=~/Library/Application Support/stremio-plus-plus/stremio-server
STREMIO_SERVER_SETTINGS=infra/stremio-server/settings.json
CLAUDE_CLI=~/.local/bin/claude
ADDON_HTTPS_PORT=8443
