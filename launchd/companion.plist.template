<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- stremio++ (FastAPI app: playback tracker, download manager, addon). Rendered by `mise run services:install`. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>io.github.fum4.stremio-plus-plus.companion</string>
  <key>ProgramArguments</key>
  <array>
    <string>@MISE@</string><string>exec</string><string>--cd</string><string>@REPO@</string>
    <string>--</string><string>scripts/with-secrets.sh</string><string>python</string><string>-m</string><string>stremio_plus_plus</string>
  </array>
  <!-- launchd's PATH is /usr/bin:/bin only: ffmpeg/ffprobe/bash 5 live in Homebrew, repo-secrets and claude in ~/.local/bin. -->
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <!-- Restart on crash only; a clean exit stays down. -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/stremio-plus-plus/companion.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/stremio-plus-plus/companion.log</string>
</dict>
</plist>
